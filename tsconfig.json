{
    "compilerOptions": {
        /* The extension is bundled by esbuild, so use bundler resolution:
           cordis is ESM-only with extensionless type imports, and esbuild
           converts everything to one CJS file for the extension host. */
        "module": "preserve",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": [
            "ES2023"
        ],
        "types": [
            "node",
            "mocha"
        ],
        /* The tavern plugin lives in `packages/` and imports the host's shared vocabulary, so one
           project covers both: `@comonad/*` is what the plugin calls the host by. */
        "paths": {
            "@comonad/*": [
                "./src/*"
            ],
            "comonad-plugin-tavern": [
                "./packages/comonad-plugin-tavern/src/index.ts"
            ],
            /* The tests reach the plugin's own modules — a card file, a preset, the prompt collection —
               the way the plugin's files reach each other. */
            "comonad-plugin-tavern/*": [
                "./packages/comonad-plugin-tavern/src/*"
            ]
        },
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src",
        "packages"
    ]
}
