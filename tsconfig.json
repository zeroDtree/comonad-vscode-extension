{
    "compilerOptions": {
        /* The extension is bundled by esbuild, so use bundler resolution:
           cordis is ESM-only with extensionless type imports, and esbuild
           converts everything to one CJS file for the extension host. */
        "module": "preserve",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": [
            "ES2023"
        ],
        "types": [
            "node",
            "mocha"
        ],
        /* Plugin packages live in `packages/` and import the host's shared vocabulary, so one
           project covers both: `@comonad/*` is what a plugin calls the host by. */
        "paths": {
            "@comonad/*": [
                "./src/*"
            ],
            "comonad-plugin-math": [
                "./packages/comonad-plugin-math/src/index.ts"
            ],
            "comonad-plugin-math/*": [
                "./packages/comonad-plugin-math/src/*"
            ],
            "comonad-plugin-pdf": [
                "./packages/comonad-plugin-pdf/src/index.ts"
            ],
            "comonad-plugin-pdf/*": [
                "./packages/comonad-plugin-pdf/src/*"
            ]
        },
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src",
        "packages"
    ],
    /* Webview guests run against DOM types and are checked by src/webview/tsconfig.json. */
    "exclude": [
        "src/webview"
    ]
}
