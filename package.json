{
  "name": "comonad",
  "displayName": "Comonad Agent",
  "description": "Local-first, auditable coding agent: graph-orchestrated tool loop, sandboxed shell, checkpoints, hooks, subagents and MCP.",
  "version": "0.3.0",
  "publisher": "zeroDtree",
  "icon": "resources/icon.png",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroDtree/comonad-vscode-extension.git"
  },
  "homepage": "https://github.com/zeroDtree/comonad-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/zeroDtree/comonad-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:comonad.review"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Project plugins, hooks and instruction files are not loaded in untrusted workspaces. Tool calls still follow the configured approval policy and OS sandbox."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "comonad.fileReview",
        "displayName": "Comonad Review",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "chatParticipants": [
      {
        "id": "comonad",
        "name": "comonad",
        "fullName": "Comonad",
        "description": "Agentic coding with tools, approvals, checkpoints and MCP",
        "isSticky": true,
        "commands": [
          {
            "name": "review",
            "description": "Review pending changes without editing"
          },
          {
            "name": "compact",
            "description": "Summarize the conversation"
          },
          {
            "name": "clear",
            "description": "Start a fresh session"
          },
          {
            "name": "new",
            "description": "Start a fresh session"
          },
          {
            "name": "fork",
            "description": "Fork this session"
          },
          {
            "name": "context",
            "description": "Show the token budget breakdown"
          },
          {
            "name": "status",
            "description": "Show mode, model, workspace and usage"
          },
          {
            "name": "cost",
            "description": "Show token usage"
          },
          {
            "name": "permissions",
            "description": "Show capabilities and permission rules"
          },
          {
            "name": "model",
            "description": "Switch the active model"
          },
          {
            "name": "help",
            "description": "List commands"
          },
          {
            "name": "init",
            "description": "Create a COMONAD.md project file"
          },
          {
            "name": "export",
            "description": "Export this session as markdown"
          },
          {
            "name": "resume",
            "description": "Resume a suspended turn"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "comonad.newSession",
        "title": "Comonad: New Session",
        "category": "Comonad",
        "icon": "$(edit)"
      },
      {
        "command": "comonad.stop",
        "title": "Comonad: Stop",
        "category": "Comonad"
      },
      {
        "command": "comonad.resumeTurn",
        "title": "Comonad: Resume Suspended Turn",
        "category": "Comonad"
      },
      {
        "command": "comonad.showDecisionTrace",
        "title": "Comonad: Show Decision Trace",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickPreset",
        "title": "Comonad: Select Preset",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickMode",
        "title": "Comonad: Select Mode",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickApproval",
        "title": "Comonad: Select Tool Approval Policy",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickApprovalResponse",
        "title": "Comonad: Select Approval Response Policy",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickSandboxMode",
        "title": "Comonad: Select Sandbox Mode",
        "category": "Comonad"
      },
      {
        "command": "comonad.toggleNetwork",
        "title": "Comonad: Toggle Network",
        "category": "Comonad"
      },
      {
        "command": "comonad.pickModel",
        "title": "Comonad: Select Model",
        "category": "Comonad"
      },
      {
        "command": "comonad.configureModel",
        "title": "Comonad: Configure Model Provider",
        "category": "Comonad"
      },
      {
        "command": "comonad.review",
        "title": "Comonad: Review Changes",
        "category": "Comonad",
        "enablement": "comonad.checkpoints"
      },
      {
        "command": "comonad.keepAll",
        "title": "Comonad: Keep All Changes",
        "category": "Comonad",
        "enablement": "comonad.checkpoints"
      },
      {
        "command": "comonad.undoAll",
        "title": "Comonad: Undo All Changes",
        "category": "Comonad",
        "enablement": "comonad.checkpoints"
      },
      {
        "command": "comonad.openChangeDiff",
        "title": "Comonad: Open Change Diff",
        "category": "Comonad",
        "icon": "resources/diff.svg",
        "enablement": "comonad.checkpoints"
      },
      {
        "command": "comonad.reviewFile",
        "title": "Comonad: Review Changed File",
        "category": "Comonad",
        "enablement": "comonad.checkpoints"
      },
      {
        "command": "comonad.git.openDiff",
        "title": "Comonad Git: Open Diff",
        "category": "Comonad",
        "icon": "$(diff)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.openFile",
        "title": "Comonad Git: Open File",
        "category": "Comonad",
        "icon": "$(go-to-file)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.stage",
        "title": "Comonad Git: Stage",
        "category": "Comonad",
        "icon": "$(add)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.unstage",
        "title": "Comonad Git: Unstage",
        "category": "Comonad",
        "icon": "$(remove)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.discard",
        "title": "Comonad Git: Discard Changes",
        "category": "Comonad",
        "icon": "$(discard)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.stageAll",
        "title": "Comonad Git: Stage All",
        "category": "Comonad",
        "icon": "$(add)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.unstageAll",
        "title": "Comonad Git: Unstage All",
        "category": "Comonad",
        "icon": "$(remove)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.git.refresh",
        "title": "Comonad Git: Refresh",
        "category": "Comonad",
        "icon": "$(refresh)",
        "enablement": "comonad.git"
      },
      {
        "command": "comonad.exportSession",
        "title": "Comonad: Export Session",
        "category": "Comonad"
      },
      {
        "command": "comonad.openSettings",
        "title": "Comonad: Open Settings",
        "category": "Comonad",
        "icon": "$(gear)"
      },
      {
        "command": "comonad.toggleHistory",
        "title": "Comonad: Recent Chats",
        "category": "Comonad",
        "icon": "$(history)"
      },
      {
        "command": "comonad.reloadMcp",
        "title": "Comonad: Reload MCP Servers",
        "category": "Comonad"
      },
      {
        "command": "comonad.showLog",
        "title": "Comonad: Show Log",
        "category": "Comonad"
      },
      {
        "command": "comonad.openSession",
        "title": "Comonad: Open Session",
        "category": "Comonad"
      },
      {
        "command": "comonad.forkSession",
        "title": "Comonad: Fork Session",
        "category": "Comonad"
      },
      {
        "command": "comonad.renameSession",
        "title": "Comonad: Rename Session",
        "category": "Comonad"
      },
      {
        "command": "comonad.deleteSession",
        "title": "Comonad: Delete Session",
        "category": "Comonad"
      },
      {
        "command": "comonad.selectWorkingDirectory",
        "title": "Comonad: Select Working Directory",
        "category": "Comonad"
      },
      {
        "command": "comonad.readTaskOutput",
        "title": "Comonad: Show Task Output",
        "category": "Comonad"
      },
      {
        "command": "comonad.stopTask",
        "title": "Comonad: Stop Task",
        "category": "Comonad"
      },
      {
        "command": "comonad.explainSelection",
        "title": "Comonad: Explain Selection",
        "category": "Comonad"
      },
      {
        "command": "comonad.fixSelection",
        "title": "Comonad: Fix or Improve Selection",
        "category": "Comonad"
      },
      {
        "command": "comonad.referenceSelection",
        "title": "Comonad: Add Selection to Chat",
        "category": "Comonad"
      },
      {
        "command": "comonad.openChat",
        "title": "Comonad: Open Chat",
        "category": "Comonad",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "comonad.openChatWindow",
        "title": "Comonad: Open Chat in a New Window",
        "category": "Comonad"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "comonad",
          "title": "Comonad",
          "icon": "resources/comonad.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "comonadChat",
          "title": "Comonad",
          "icon": "resources/comonad.svg"
        }
      ]
    },
    "views": {
      "comonad": [
        {
          "id": "comonad.sessions",
          "name": "Sessions"
        },
        {
          "id": "comonad.git",
          "name": "Git Changes",
          "when": "comonad.git"
        },
        {
          "id": "comonad.tasks",
          "name": "Tasks"
        }
      ],
      "comonadChat": [
        {
          "id": "comonad.chat",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/comonad.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "comonad.openChat",
          "when": "view == comonad.sessions",
          "group": "navigation@0"
        },
        {
          "command": "comonad.newSession",
          "when": "view == comonad.sessions",
          "group": "navigation@1"
        },
        {
          "command": "comonad.openSettings",
          "when": "view == comonad.sessions",
          "group": "navigation@2"
        },
        {
          "command": "comonad.selectWorkingDirectory",
          "when": "view == comonad.sessions",
          "group": "navigation@3"
        },
        {
          "command": "comonad.toggleHistory",
          "when": "view == comonad.chat",
          "group": "navigation@0"
        },
        {
          "command": "comonad.openSettings",
          "when": "view == comonad.chat",
          "group": "navigation@2"
        },
        {
          "command": "comonad.newSession",
          "when": "view == comonad.chat",
          "group": "navigation@3"
        },
        {
          "command": "comonad.git.refresh",
          "when": "view == comonad.git",
          "group": "navigation@0"
        },
        {
          "command": "comonad.git.stageAll",
          "when": "view == comonad.git",
          "group": "navigation@1"
        },
        {
          "command": "comonad.git.unstageAll",
          "when": "view == comonad.git",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "comonad.toggleHistory",
          "when": "activeWebviewPanelId == comonad.chat",
          "group": "navigation@0"
        },
        {
          "command": "comonad.openSettings",
          "when": "activeWebviewPanelId == comonad.chat",
          "group": "navigation@2"
        },
        {
          "command": "comonad.newSession",
          "when": "activeWebviewPanelId == comonad.chat",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "comonad.openSession",
          "when": "view == comonad.sessions && viewItem == comonad.session",
          "group": "inline@1"
        },
        {
          "command": "comonad.forkSession",
          "when": "view == comonad.sessions && viewItem == comonad.session",
          "group": "1_manage@1"
        },
        {
          "command": "comonad.renameSession",
          "when": "view == comonad.sessions && viewItem == comonad.session",
          "group": "1_manage@2"
        },
        {
          "command": "comonad.deleteSession",
          "when": "view == comonad.sessions && viewItem == comonad.session",
          "group": "1_manage@3"
        },
        {
          "command": "comonad.readTaskOutput",
          "when": "view == comonad.tasks && viewItem == comonad.task",
          "group": "inline@1"
        },
        {
          "command": "comonad.stopTask",
          "when": "view == comonad.tasks && viewItem == comonad.task",
          "group": "1_manage@1"
        },
        {
          "command": "comonad.git.openDiff",
          "when": "view == comonad.git && viewItem =~ /^git-change-/",
          "group": "inline@1"
        },
        {
          "command": "comonad.git.stage",
          "when": "view == comonad.git && (viewItem == git-change-changes || viewItem == git-change-untracked || viewItem == git-change-merge)",
          "group": "inline@2"
        },
        {
          "command": "comonad.git.unstage",
          "when": "view == comonad.git && viewItem == git-change-staged",
          "group": "inline@2"
        },
        {
          "command": "comonad.git.discard",
          "when": "view == comonad.git && (viewItem == git-change-changes || viewItem == git-change-untracked)",
          "group": "inline@3"
        },
        {
          "command": "comonad.git.openFile",
          "when": "view == comonad.git && viewItem =~ /^git-change-/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "comonad.explainSelection",
          "when": "editorHasSelection",
          "group": "comonad@1"
        },
        {
          "command": "comonad.fixSelection",
          "when": "editorHasSelection",
          "group": "comonad@2"
        },
        {
          "command": "comonad.referenceSelection",
          "when": "editorHasSelection",
          "group": "comonad@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "comonad.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+n",
        "when": "comonad.chatFocused || focusedView == comonad.chat || focusedView == comonad.sessions || focusedView == comonad.tasks || activeWebviewPanelId == comonad.chat || (auxiliaryBarFocus && activeAuxiliary == workbench.view.extension.comonadChat)"
      },
      {
        "command": "comonad.openChat",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "comonad.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+."
      },
      {
        "command": "comonad.review",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "comonad.checkpoints"
      },
      {
        "command": "comonad.referenceSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "(comonad.chatPanel || activeAuxiliary == workbench.view.extension.comonadChat || activeViewlet == workbench.view.extension.comonadChat || (comonad.chatUsed && !auxiliaryBarVisible)) && editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && node esbuild.js --plugin",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "reinstall": "bash scripts/reinstall.sh",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "build:plugins": "node esbuild.js --plugin",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview-tsc": "tsc --noEmit --watch --project src/webview/tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && node esbuild.js --plugin --production",
    "compile-tests": "node esbuild.js --tests",
    "watch-tests": "node esbuild.js --tests --watch",
    "pretest": "npm run compile && npm run compile-tests",
    "check-types": "tsc --noEmit && tsc --noEmit --project src/webview/tsconfig.json",
    "lint": "eslint src packages",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "unpdf": "^1.9.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@agnai/web-tokenizers": "^0.1.6-pre3",
    "cordis": "^4.0.0-rc.10",
    "gpt-tokenizer": "^4.0.0",
    "schemastery": "^3.18.0",
    "tiny-pinyin": "^1.3.2",
    "yaml": "^2.9.1"
  }
}
